<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar tema</title>
</head>
<body>
  <h1>Editar tema</h1>

  <form action="/topics/<%= topic.id %>/update" method="POST">
    <input
      type="text"
      name="title"
      value="<%= topic.title %>"
      required
    >

    <textarea name="description" required><%= topic.description %></textarea>

    <button type="submit">Guardar cambios</button>
  </form>

  <a href="/">Volver</a>
</body>
</html>