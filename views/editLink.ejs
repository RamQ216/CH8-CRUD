<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar link</title>
</head>
<body>
  <h1>Editar link</h1>

  <form action="/links/<%= link.id %>/update" method="POST">
    <input
      type="text"
      name="title"
      value="<%= link.title %>"
      required
    >

    <input
      type="url"
      name="url"
      value="<%= link.url %>"
      required
    >

    <textarea name="description" required><%= link.description %></textarea>

    <button type="submit">Guardar cambios</button>
  </form>

  <a href="/">Volver</a>
</body>
</html>